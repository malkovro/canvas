#!/usr/bin/env python3
"""The canvas store, from a shell.

A thin shim over canvas.cli.main. The store lives in canvas/store.py, the
document in canvas/document.py and the vocabulary in schema/canvas.rng;
nothing here knows anything about any of them.

    bin/canvas create  [<canvas-id>] --problem TEXT --expected-value TEXT
    bin/canvas read    <canvas-id> [--id NODE-ID]... [--type NAME]... [--provenance] [--since SHA]
    bin/canvas render  <canvas-id> [--format page|comment]
    bin/canvas history <canvas-id> <node-id>
    bin/canvas replace <canvas-id> <node-id> --why TEXT
    bin/canvas insert  <canvas-id> (--after <node-id> | --into <id>) --why TEXT
    bin/canvas remove  <canvas-id> <node-id> --why TEXT
    bin/canvas move    <canvas-id> <node-id> (--after <node-id> | --into <id>) --why TEXT
    bin/canvas freeze  <canvas-id> --why TEXT

`--why` is required by all four editing verbs, and by `freeze`, and has no
default. `read`, `render` and `history` are reads: they write nothing, commit
nothing and initialise nothing — and they go on working once a canvas has been
frozen, which every write verb is refused against at exit 1. `read`'s four
flags are reads on the same terms and acquire nothing: `--id` and `--type`
select part of the document, `--provenance` says who last wrote each node
printed and at which commit, and `--since` says what changed between a sha and
the head without applying any of it. `render` prints the canvas as a projection
on stdout: one standalone HTML page by default, or `--format comment` for the
block-level Markdown a Basecamp comment renders, which is what a ledger row
carries in the one comment it rewrites in place. Either way it is a projection,
so it is never edited and never read back, and redirecting stdout is how it
becomes a file.

Exit 0 if it worked, 1 if the request is wrong against the store as it stands,
2 if the tool or its environment is wrong.

Every refusal prints the same shape on stderr: what is wrong, whatever came
with it, then `Canvas-Node:` for every node involved, `Canvas-About:` for what
it names where it has no node, `Canvas-Next:` for the one thing to do that
would succeed, and `Canvas-Exit:` for the code and what the code means. The
argument parser's own refusals are in that shape too. See README section
*What a refusal prints*.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from canvas.cli import main

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
