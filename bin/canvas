#!/usr/bin/env python3
"""The canvas store, from a shell.

A thin shim over canvas.cli.main. The store lives in canvas/store.py, the
document in canvas/document.py and the vocabulary in schema/canvas.rng;
nothing here knows anything about any of them.

    bin/canvas create  <ledger_id> --problem TEXT --expected-value TEXT
    bin/canvas read    <ledger_id>
    bin/canvas history <ledger_id> <node-id>
    bin/canvas replace <ledger_id> <node-id> --why TEXT
    bin/canvas insert  <ledger_id> (--after <node-id> | --into <id>) --why TEXT
    bin/canvas remove  <ledger_id> <node-id> --why TEXT
    bin/canvas move    <ledger_id> <node-id> (--after <node-id> | --into <id>) --why TEXT
    bin/canvas freeze  <ledger_id> --why TEXT

`--why` is required by all four editing verbs, and by `freeze`, and has no
default. `read` and `history` are reads: they write nothing, commit nothing and
initialise nothing — and they go on working once a canvas has been frozen,
which every write verb is refused against at exit 1.

Exit 0 if it worked, 1 if the request is wrong against the store as it stands,
2 if the tool or its environment is wrong.

Every refusal prints the same shape on stderr: what is wrong, whatever came
with it, then `Canvas-Node:` for every node involved, `Canvas-About:` for what
it names where it has no node, `Canvas-Next:` for the one thing to do that
would succeed, and `Canvas-Exit:` for the code and what the code means. The
argument parser's own refusals are in that shape too. See README section
*What a refusal prints*.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from canvas.cli import main

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
