#!/usr/bin/env python3
"""Report line-number citations whose quoted passage has moved.

    bin/canvas-citations [ROOT ...]

Exit 0 if every quoted citation this can decide lands on its quote, 1 if one
has drifted (each printed with the range that now holds it), 2 if the check
itself cannot run. See canvas/citations.py for what "can decide" excludes.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from canvas.citations import main

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
